<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="guangzhou_wind_timeseries">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-280 -400 160 0 0.9 0</pose>
      </camera>
    </gui>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://guangzhou_buildings</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://iris_wind_quad_timeseries</uri>
      <pose>-280 -400 50 0 0 0</pose>
    </include>
  </world>
</sdf>
