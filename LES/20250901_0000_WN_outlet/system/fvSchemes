FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// LES schemes from pisoFoam/LES/motorBike (v2412).
// Laplacian/snGrad limited 0.5 because this urban mesh maxNonOrtho ~65°.

ddtSchemes
{
    default         backward;
}

gradSchemes
{
    default         Gauss linear;
    grad(U)         cellLimited Gauss linear 1;
}

divSchemes
{
    default         none;

    // LUST (motorBike LES) blew up on this snappy mesh at one building-side
    // cell. linearUpwindV is 2nd-order but upwind-biased; suitable for WMLES
    // on a RANS-grade urban mesh. Revisit LUST after a cleaner mesh.
    div(phi,U)      Gauss linearUpwindV grad(U);

    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear limited corrected 0.5;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         limited corrected 0.5;
}

wallDist
{
    method          meshWave;
}

