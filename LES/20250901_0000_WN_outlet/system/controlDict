FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Smoke: 5 s physical. Adaptive dt, but writes stay on integer seconds
// via adjustableRunTime. After smoke, set endTime 100 and keep writeInterval.
// 100 s production from latestTime (smoke ended at t=5).
// Adaptive dt; writes on 5 s marks via adjustableRunTime.

application     pimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         100;

deltaT          0.01;

writeControl    adjustableRunTime;

writeInterval   5;

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       0.02;

functions
{
    minMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (U p nut);
        writeControl    timeStep;
        writeInterval   10;
        log             true;
    }

    yPlus1
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        writeFields     true;
    }

    phi_west
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeFields     false;
        regionType      patch;
        name            west;
        operation       sum;
        fields          (phi);
        writeControl    writeTime;
        log             true;
    }
    phi_east
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeFields     false;
        regionType      patch;
        name            east;
        operation       sum;
        fields          (phi);
        writeControl    writeTime;
        log             true;
    }
    phi_south
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeFields     false;
        regionType      patch;
        name            south;
        operation       sum;
        fields          (phi);
        writeControl    writeTime;
        log             true;
    }
    phi_north
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeFields     false;
        regionType      patch;
        name            north;
        operation       sum;
        fields          (phi);
        writeControl    writeTime;
        log             true;
    }
    phi_upper
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeFields     false;
        regionType      patch;
        name            upper;
        operation       sum;
        fields          (phi);
        writeControl    writeTime;
        log             true;
    }
}

