FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system";
    object      blockMeshDict;
/*
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
*/
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

vertices
(
    //ground height:0
    (-5000 -5000 0)
    ( 5000 -5000 0)
    ( 5000  5000 0)
    (-5000  5000 0)
    (-5000 -5000 2000)
    ( 5000 -5000 2000)
    ( 5000  5000 2000)
    (-5000  5000 2000)
);

blocks
(
    // 注意：Z方向用了 simpleGrading (1 1 3)
    // 意思是顶部的网格是底部网格厚度的 3 倍。
    // 这样可以让地面（建筑物）附近的背景网格更密，而高空稀疏，节省资源且提高质量。
    hex (0 1 2 3 4 5 6 7) (100 100 40) simpleGrading (1 1 3)
);

edges
(
);

boundary
(
    west  { type patch; faces ((0 4 7 3)); }
    east  { type patch; faces ((1 2 6 5)); }
    south { type patch; faces ((0 1 5 4)); }
    north { type patch; faces ((3 7 6 2)); }
    lower { type wall;  faces ((0 3 2 1)); }
    upper { type patch; faces ((4 5 6 7)); }
);

mergePatchPairs
(
);

