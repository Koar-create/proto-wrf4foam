FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      momentumTransport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// pimpleFoam v2412 does not read this file. Kept in sync with
// turbulenceProperties so a later foamRun switch does not silently go RAS.

simulationType  LES;

LES
{
    model           WALE;
    turbulence      on;
    printCoeffs     on;
}

