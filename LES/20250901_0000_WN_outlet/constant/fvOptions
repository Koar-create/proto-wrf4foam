FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Smoke-1 (LUST) blew up at (1585,-1397,232): |U|->6e4, nut->6e3.
// Caps are safety nets for a handful of snappy cells, not a turbulence model.

limitU
{
    type            limitVelocity;
    libs            ("libfvOptions.so");
    selectionMode   all;
    max             25;
}

limitNut
{
    type            limitTurbulenceViscosity;
    libs            ("libfvOptions.so");
    selectionMode   all;
    // nut_max = c * nu = 3.33e5 * 1.5e-5 = 5 m2/s
    c               3.33e5;
}

